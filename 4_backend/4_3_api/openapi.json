          {
            "name": "id_user",
            "in": "path",
            "description": "User ID to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted user.",
