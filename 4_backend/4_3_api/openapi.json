    "/api/remove_role_from_user/{id_user}/{slug}": {
      "delete": {
        "tags": [
          "users_roles"
        ],
        "summary": "Removing a role from a user",
        "operationId": "remove_role_from_user",
        "parameters": [
          {
            "name": "id_user",
            "in": "path",
            "description": "User ID to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "slug",
            "in": "path",
            "description": "Slug of role to delete.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully removed a role from a user.",
