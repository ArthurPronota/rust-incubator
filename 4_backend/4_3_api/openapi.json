  "components": {
    "schemas": {
      "AddRoleToUser": {
        "type": "object",
        "description": "Добвить роль к пользователю",
        "required": [
          "slug",
          "id_user"
        ],
        "properties": {
          "id_user": {
            "type": "integer",
            "format": "int32",
            "description": "Id user",
            "minimum": 0
          },
          "slug": {
            "type": "string",
            "description": "Код роли"
          }
        }
      },
      "CreateRole": {
        "type": "object",
        "description": "Создать роль",
        "required": [
          "slug",
          "name",
          "permissions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Текстовое наименоывание роли"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slug": {
            "type": "string",
            "description": "Slug: name-of-role"
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Responce": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "Success"
            ],
            "properties": {
              "Success": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "Error"
            ],
            "properties": {
              "Error": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "UserWithRole"
            ],
            "properties": {
              "UserWithRole": {
                "$ref": "#/components/schemas/UserWithRole"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "UsersRoles"
            ],
            "properties": {
              "UsersRoles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserWithRole"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "Role"
            ],
            "properties": {
              "Role": {
                "$ref": "#/components/schemas/Role"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "ListRoles"
            ],
            "properties": {
              "ListRoles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          }
        ]
      },
      "Role": {
        "type": "object",
        "description": "Роль",
        "required": [
          "slug",
          "name",
          "permissions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "наименование роли"
          },
          "permissions": {
            "type": "string",
            "description": "разрешения для роли"
          },
          "slug": {
            "type": "string",
            "description": "код роли"
          }
        }
      },
      "UpdateEmailUser": {
        "type": "object",
        "description": "Модифицировать email у пользователя",
        "required": [
          "new_email",
          "id_user"
        ],
        "properties": {
          "id_user": {
            "type": "integer",
            "format": "int32",
            "description": "Id user",
            "minimum": 0
          },
          "new_email": {
            "type": "string"
          }
        }
      },
      "UpdateNameRole": {
        "type": "object",
        "description": "Модифицировать имя у роли",
        "required": [
          "new_name",
          "slug"
        ],
        "properties": {
          "new_name": {
            "type": "string",
            "description": "Наименование роли"
          },
          "slug": {
            "type": "string",
            "description": "Код роли"
          }
        }
      },
      "UpdateNameUser": {
        "type": "object",
        "description": "Модифицировать имя у пользователю",
        "required": [
          "new_name",
          "id_user"
        ],
        "properties": {
          "id_user": {
            "type": "integer",
            "format": "int32",
            "description": "Id user",
            "minimum": 0
          },
          "new_name": {
            "type": "string"
          }
        }
      },
      "UpdatePermissionsRole": {
        "type": "object",
        "required": [
          "slug",
          "new_permissions"
        ],
        "properties": {
          "new_permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "description": "Структура пользователя",
        "required": [
          "id_user",
          "name",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "email пользователя"
          },
          "id_user": {
            "type": "integer",
            "format": "int32",
            "description": "Код пользователя",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "Натменование пользователя"
          }
        }
      },
      "UserWithRole": {
        "type": "object",
        "description": "Пользователь с его ролями",
        "required": [
          "user",
          "list_roles"
        ],
        "properties": {
          "list_roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "initdb",
      "description": "Creating the necessary objects in the database"
    },
    {
      "name": "users",
      "description": "Working with users"
    },
    {
      "name": "roles",
      "description": "Working with roles"
    },
    {
      "name": "users_roles",
      "description": "Manipulating user roles"
    }
  ]
}