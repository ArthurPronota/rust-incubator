{
  "openapi": "3.1.0",
  "info": {
    "title": "API for working with users and their roles.",
    "description": "RESTful API for managing users and roles",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/create_user": {
      "post": {
        "tags": [
          "users"
        ],
        "operationId": "create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Creating a user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Success": "User created successfully."
                }
              }
            }
          },
          "201": {
            "description": "Error creating user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Error": "Duplicate user email."
                }
              }
            }
          }
        }
      }
    },
    "/api/delete_user/{id_user}": {
      "delete": {
        "tags": [
          "users"
        ],
        "operationId": "delete_user",
        "parameters": [
          {
            "name": "id_user",
            "in": "path",
            "description": "User ID to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Success": "The user has been deleted."
                }
              }
            }
          },
          "201": {
            "description": "Error deleting user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Error": "The user does not exist."
                }
              }
            }
          }
        }
      }
    },
    "/api/initdb": {
      "get": {
        "tags": [
          "initdb"
        ],
        "operationId": "initdb_handle",
        "responses": {
          "200": {
            "description": "Creating database objects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Success": "Database objects created successfully."
                }
              }
            }
          },
          "201": {
            "description": "Error creating database objects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Error": "Error creating trigger."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUser": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Responce": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "Success"
            ],
            "properties": {
              "Success": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "Error"
            ],
            "properties": {
              "Error": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "initdb",
      "description": "Creating the necessary objects in the database"
    },
    {
      "name": "users",
      "description": "Working with users"
    }
  ]
}