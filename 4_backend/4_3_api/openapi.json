          }
        }
      }
    },
    "/api/delete_role/{slug}": {
      "delete": {
        "tags": [
          "roles"
        ],
        "summary": "Deleting a role.",
        "operationId": "delete_role",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Slug of role to delete.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful role deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Success": "The role was successfully removed."
                }
              }
            }
          },
          "201": {
            "description": "Error deleting role.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Error": "The default role cannot be deleted."
                }
              }
            }
          }
        }
      }
    },
    "/api/delete_user/{id_user}": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Deleting a user.",
        "operationId": "delete_user",
