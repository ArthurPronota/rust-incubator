  "paths": {
    "/api/add_role_to_user": {
      "post": {
        "tags": [
          "users_roles"
        ],
        "summary": "Add a role to a user",
        "operationId": "add_role_to_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRoleToUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully added role to user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Success": "The role has been successfully added to the user."
                }
              }
            }
          },
          "201": {
            "description": "Error adding role to user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Responce"
                },
                "example": {
                  "Error": "Not found user for id_user: 100"
                }
              }
            }
          }
        }
      }
    },
