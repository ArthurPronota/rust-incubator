pub mod logger {
// Примитив синхронизации, в который номинально можно записать данные 
// только один раз.
use std::sync::OnceLock;

use tracing::{
        Level,
        Subscriber
    };

use tracing_subscriber::{
        EnvFilter, filter, fmt::{
            self, FormatEvent, MakeWriter, format::JsonFields, time::FormatTime
        }, prelude::*, registry::LookupSpan, util::SubscriberInitExt
};

use chrono::{
        DateTime, 
        Utc,
        SecondsFormat
    };

// Трейты, помошники и типовые определения для ядра I/O функциональности.
use std::io;




