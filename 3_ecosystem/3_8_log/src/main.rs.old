// 1. Простой посетитель для сбора полей в Map
struct FieldVisitor {
    fields: Map<String, Value>,
}

impl FieldVisitor {
    fn new() -> Self {
        Self {
            fields: Map::new(),
        }
    }
    
    fn into_inner(self) -> Map<String, Value> {
        self.fields
    }
}

impl tracing::field::Visit for FieldVisitor {
    fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
        self.fields.insert(field.name().to_string(), Value::String(value.to_string()));
    }
    
    fn record_bool(&mut self, field: &tracing::field::Field, value: bool) {
        self.fields.insert(field.name().to_string(), Value::Bool(value));
    }
    
    fn record_u64(&mut self, field: &tracing::field::Field, value: u64) {
        self.fields.insert(field.name().to_string(), Value::Number(value.into()));
    }
    
    fn record_i64(&mut self, field: &tracing::field::Field, value: i64) {
        self.fields.insert(field.name().to_string(), Value::Number(value.into()));
    }
    
    fn record_f64(&mut self, field: &tracing::field::Field, value: f64) {
        self.fields.insert(field.name().to_string(), 
            serde_json::Number::from_f64(value).map_or(Value::Null, Value::Number));
    }
    
    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
        self.fields.insert(field.name().to_string(), 
            Value::String(format!("{:?}", value)));
    }
}

// 2. Посетитель с трансформацией имён полей
struct RenamingVisitor {
    fields: Map<String, Value>,
}

impl RenamingVisitor {
    fn new() -> Self {
        Self {
            fields: Map::new(),
        }
    }
    
    fn transform_field_name(&self, name: &str) -> String {
        match name {
            "message" => "log.message".to_string(),
            "error" => "error.message".to_string(),
            "user_id" => "user.id".to_string(),
            "span_id" => "trace.span_id".to_string(),
            "trace_id" => "trace.id".to_string(),
            _ => format!("event.{}", name),
        }
    }
}

impl tracing::field::Visit for RenamingVisitor {
    fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
        let transformed = self.transform_field_name(field.name());
        self.fields.insert(transformed, Value::String(value.to_string()));
    }
    
    fn record_bool(&mut self, field: &tracing::field::Field, value: bool) {
        let transformed = self.transform_field_name(field.name());
        self.fields.insert(transformed, Value::Bool(value));
    }
    
    fn record_u64(&mut self, field: &tracing::field::Field, value: u64) {
        let transformed = self.transform_field_name(field.name());
        self.fields.insert(transformed, Value::Number(value.into()));
    }
    
    fn record_i64(&mut self, field: &tracing::field::Field, value: i64) {
        let transformed = self.transform_field_name(field.name());
        self.fields.insert(transformed, Value::Number(value.into()));
    }
    
    fn record_f64(&mut self, field: &tracing::field::Field, value: f64) {
        let transformed = self.transform_field_name(field.name());
        self.fields.insert(transformed, 
            serde_json::Number::from_f64(value).map_or(Value::Null, Value::Number));
    }
    
    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
        let transformed = self.transform_field_name(field.name());
        self.fields.insert(transformed, Value::String(format!("{:?}", value)));
    }
}

// 3. Кастомный форматтер с посетителем
struct CustomJsonFormatter;

impl CustomJsonFormatter {
    fn format_level(level: &Level) -> &'static str {
        match *level {
            Level::TRACE => "TRACE",
            Level::DEBUG => "DEBUG",
            Level::INFO => "INFO",
            Level::WARN => "WARN",
            Level::ERROR => "ERROR",
        }
    }
}

impl<S, N> fmt::FormatEvent<S, N> for CustomJsonFormatter
where
    S: Subscriber + for<'a> LookupSpan<'a>,
    N: for<'a> FormatFields<'a> + 'static,
{
    fn format_event(
        &self,
        ctx: &FmtContext<'_, S, N>,
        mut writer: Writer<'_>,
        event: &Event<'_>,
    ) -> std::fmt::Result {
        // Получаем метаданные события
        let meta = event.metadata();
        
        // ---- Способ 1: Использование кастомного посетителя ----
        let mut visitor = FieldVisitor::new();
        event.record(&mut visitor);
        let event_fields = visitor.into_inner();
        
        // Создаём JSON с кастомными ключами
        let mut json_map = Map::new();
        
        // Основные поля
        json_map.insert("@timestamp".to_string(), 
            json!(Utc::now().to_rfc3339_opts(SecondsFormat::Nanos, true)));
        json_map.insert("log.level".to_string(), 
            json!(Self::format_level(meta.level())));
        json_map.insert("log.logger".to_string(), 
            json!(meta.target()));
        json_map.insert("process.thread".to_string(), 
            json!(format!("{:?}", std::thread::current().id())));
        
        // Добавляем поля события
        for (key, value) in event_fields {
            json_map.insert(format!("event.{}", key), value);
        }
        
        /*
        // ---- Способ 2: Использование JsonVisitor из tracing-subscriber ----
        let mut json_value = json!({});
        let mut json_visitor = JsonVisitor::new(&mut json_value);
        event.record(&mut json_visitor);
        
        // ---- Способ 3: Использование посетителя с переименованием ----
        let mut renaming_visitor = RenamingVisitor::new();
        event.record(&mut renaming_visitor);
        let renamed_fields = renaming_visitor.fields;
         */
        /*
        // ---- Способ 4: Комбинированный подход с извлечением сообщения ----
        let mut message = String::new();
        let mut message_visitor = MessageExtractorVisitor {
            message: &mut message,
        };
        event.record(&mut message_visitor);
        
        if !message.is_empty() {
            json_map.insert("log.message".to_string(), json!(message));
        }
         */

        /*
        // Добавляем информацию о спанах
        let mut span_names = Vec::new();
        let mut span_context = Vec::new();
        
        if let Some(scope) = ctx.event_scope() {
            for span in scope.from_root() {
                span_names.push(span.name().to_string());
                
                // Собираем поля спана
                let extensions = span.extensions();
                if let Some(visitor) = extensions.get::<JsonVisitor>() {
                    // Работаем с полями спана
                }
            }
        }
        
        if !span_names.is_empty() {
            json_map.insert("trace.spans".to_string(), json!(span_names));
        }
         */
        
        // Финальный JSON объект
        let final_json = json!(json_map);
        
        // Записываем в Writer
        write!(writer, "{}", serde_json::to_string(&final_json).unwrap())?;
        writeln!(writer)?;
        
        Ok(())
    }
}

// Посетитель для извлечения сообщения
struct MessageExtractorVisitor<'a> {
    message: &'a mut String,
}

impl<'a> tracing::field::Visit for MessageExtractorVisitor<'a> {
    fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
        if field.name() == "message" {
            self.message.push_str(value);
        }
    }
    
    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
        if field.name() == "message" {
            self.message.push_str(&format!("{:?}", value));
        }
    }
    
    // Для остальных методов - игнорируем
    fn record_bool(&mut self, _field: &tracing::field::Field, _value: bool) {}
    fn record_u64(&mut self, _field: &tracing::field::Field, _value: u64) {}
    fn record_i64(&mut self, _field: &tracing::field::Field, _value: i64) {}
    fn record_f64(&mut self, _field: &tracing::field::Field, _value: f64) {}
}

// 4. Расширенный посетитель с поддержкой вложенных структур
struct NestedJsonVisitor {
    output: Map<String, Value>,
    current_path: Vec<String>,
}

impl NestedJsonVisitor {
    fn new() -> Self {
        Self {
            output: Map::new(),
            current_path: Vec::new(),
        }
    }
    
    fn insert_value(&mut self, field: &tracing::field::Field, value: Value) {
        let parts: Vec<&str> = field.name().split('.').collect();
        
        if parts.len() == 1 {
            self.output.insert(field.name().to_string(), value);
        } else {
            // Создаем вложенную структуру
            let mut current = &mut self.output;
            for (i, part) in parts.iter().enumerate() {
                if i == parts.len() - 1 {
                    current.insert(part.to_string(), value.clone());
                } else {
                    if !current.contains_key(*part) {
                        current.insert(part.to_string(), json!({}));
                    }

                    if current.get_mut(*part).and_then(|v| v.as_object_mut()).is_some() {
                        current = current.get_mut(*part).and_then(|v| v.as_object_mut()).unwrap() ;
                    }

                    /*
                    if let Some(&mut obj) = current.get_mut(*part).and_then(|v| v.as_object_mut()) {
                        current = *obj;
                    }
                     */
                }
            }
        }
    }
}

impl tracing::field::Visit for NestedJsonVisitor {
    fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
        self.insert_value(field, Value::String(value.to_string()));
    }
    
    fn record_bool(&mut self, field: &tracing::field::Field, value: bool) {
        self.insert_value(field, Value::Bool(value));
    }
    
    fn record_u64(&mut self, field: &tracing::field::Field, value: u64) {
        self.insert_value(field, Value::Number(value.into()));
    }
    
    fn record_i64(&mut self, field: &tracing::field::Field, value: i64) {
        self.insert_value(field, Value::Number(value.into()));
    }
    
    fn record_f64(&mut self, field: &tracing::field::Field, value: f64) {
        if let Some(num) = serde_json::Number::from_f64(value) {
            self.insert_value(field, Value::Number(num));
        }
    }
    
    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
        self.insert_value(field, Value::String(format!("{:?}", value)));
    }
}

// 5. Финальная реализация форматтера
struct ElasticJsonFormatter;

impl<S, N> fmt::FormatEvent<S, N> for ElasticJsonFormatter
where
    S: Subscriber + for<'a> LookupSpan<'a>,
    N: for<'a> FormatFields<'a> + 'static,
{
    fn format_event(
        &self,
        ctx: &FmtContext<'_, S, N>,
        mut writer: Writer<'_>,
        event: &Event<'_>,
    ) -> std::fmt::Result {
        let meta = event.metadata();
        
        // Используем посетитель для сбора всех полей
        let mut visitor = NestedJsonVisitor::new();
        event.record(&mut visitor);
        
        // Создаем корневой объект
        let mut root = Map::new();
        
        // ECS (Elastic Common Schema) поля
        root.insert("@timestamp".to_string(), 
            json!(Utc::now().to_rfc3339_opts(SecondsFormat::Nanos, true)));
        root.insert("log.level".to_string(), 
            json!(meta.level().to_string()));
        root.insert("log.logger".to_string(), 
            json!(meta.target()));
        
        // Добавляем все поля события
        for (key, value) in visitor.output {
            println!("key: {}, value: {}", key, value) ;
            root.insert(key, value);
        }
        
        // Добавляем информацию о спане, если есть
        if let Some(scope) = ctx.event_scope() {
            let spans: Vec<Value> = scope.from_root()
                .map(|span| {
                    json!({
                        "name": span.name(),
                        "target": span.metadata().target(),
                    })
                })
                .collect();
            
            if !spans.is_empty() {
                root.insert("trace.spans".to_string(), json!(spans));
            }
        }
        
        // Записываем результат
        write!(writer, "{}", serde_json::to_string(&root).unwrap())?;
        writeln!(writer)?;
        
        Ok(())
    }
}

