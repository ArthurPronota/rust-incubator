/// Макрос для логирования с автоматическим определением файла лога
//#[macro_export]
macro_rules! log {
    ($level:expr, $msg:expr $(, $field:expr => $value:expr )*) => {
        {
            //let file = $crate::logger::get_log_filename(module_path!());
            tracing::event!(
                //target: module_path!(),
                $level,
                //lvl = %$level, 
                file = "app.log",
                msg = $msg
                $(, $field = $value )*
            );
        }
    };
}

// Экспортируем макрос для использования внутри крейта по пути
pub(crate) use log;

/// Удобные макросы для разных уровней логирования
#[macro_export]
macro_rules! log_error {
    ($msg:expr $(, $field:expr => $value:expr )*) => {
        crate::logger::log!(tracing::Level::ERROR, $msg $(, $field => $value )*);
    };
}

#[macro_export]
macro_rules! log_warn {
    ($msg:expr $(, $field:expr => $value:expr )*) => {
        crate::logger::log!(tracing::Level::WARN, $msg $(, $field => $value )*);
    };
}

#[macro_export]
macro_rules! log_info {
    ($msg:expr $(, $field:expr => $value:expr )*) => {
        crate::logger::log!(tracing::Level::INFO, $msg $(, $field => $value )*);
    };
}

#[macro_export]
macro_rules! log_debug {
    ($msg:expr $(, $field:expr => $value:expr )*) => {
        crate::logger::log!(tracing::Level::DEBUG, $msg $(, $field => $value )*);
    };
}

#[macro_export]
macro_rules! log_trace {
    ($msg:expr $(, $field:expr => $value:expr )*) => {
        crate::logger::log!(tracing::Level::TRACE, $msg $(, $field => $value )*);
    };
}
}

fn main() {
    use logger ;

    /*
    let mut v = vec![
                logger::Level::DEBUG,
                Level::ERROR,
                Level::INFO,
                Level::TRACE,
                Level::WARN,
                            ] ;
        println!("v: {:?}", {v.sort() ;v}) ;
    */

    logger::init_logger();

    log_info!("Application started", "version" => "1.0.0") ;
    log_error!("Application started", "version" => "1.0.0") ;
    log_warn!("Application started", "version" => "1.0.0") ;
}
